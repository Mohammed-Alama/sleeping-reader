{
  "name": "Sleep PDF",
  "short_name": "Sleep PDF",
  "description": "Read yourself to sleep. Pages drift past slowly so you can read lying down without touching anything.",
  "start_url": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0b0a09",
  "theme_color": "#0b0a09",
  "icons": [
    {
      "src": "/icons/icon-192x192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/icons/icon-512x512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    },
    {
      "src": "/icons/icon-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "categories": ["books", "utilities"],
  "file_handlers": [
    {
      "action": "/",
      "accept": {
        "application/pdf": [".pdf"]
      }
    }
  ]
}
